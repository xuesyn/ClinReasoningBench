      }
    ],
  
    "rules": [
        {
          "id": 9001,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "Tis" },
          "required_keys": ["infer_tnm", "pathology_carcinoma_in_situ"],
          "expr": "infer_tnm == '是' && pathology_carcinoma_in_situ == '是'",
          "describe": "T推断：Tis（原位癌）。"
        },
        {
          "id": 9002,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T1mi" },
          "required_keys": ["infer_tnm", "pathology_microinvasive_adenocarcinoma"],
          "expr": "infer_tnm == '是' && pathology_microinvasive_adenocarcinoma == '是'",
          "describe": "T推断：T1mi（微浸润性腺癌）。"
        },
        {
          "id": 9003,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "TX" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "cytology_positive", "pathology_carcinoma_in_situ", "pathology_microinvasive_adenocarcinoma"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence in ['无','不明'] && cytology_positive == '是' && pathology_carcinoma_in_situ != '是' && pathology_microinvasive_adenocarcinoma != '是'",
          "describe": "T推断：TX（未发现原发肿瘤，或影像/支气管镜无法发现，但痰细胞学/灌洗发现癌细胞）。"
        },
        {
          "id": 9004,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T0" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "cytology_positive", "pathology_carcinoma_in_situ", "pathology_microinvasive_adenocarcinoma"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence == '无' && cytology_positive != '是' && pathology_carcinoma_in_situ != '是' && pathology_microinvasive_adenocarcinoma != '是'",
          "describe": "T推断：T0（无原发肿瘤证据）。"
        },
      
        {
          "id": 9010,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T4" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "tumor_max_diameter_cm", "mediastinum_invasion", "heart_invasion", "great_vessels_invasion", "carina_invasion", "recurrent_laryngeal_nerve_invasion", "trachea_invasion", "esophagus_invasion", "vertebral_body_invasion", "diaphragm_invasion", "ipsilateral_different_lobe_nodule"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence == '有' && (tumor_max_diameter_cm > 7 || mediastinum_invasion == '是' || heart_invasion == '是' || great_vessels_invasion == '是' || carina_invasion == '是' || recurrent_laryngeal_nerve_invasion == '是' || trachea_invasion == '是' || esophagus_invasion == '是' || vertebral_body_invasion == '是' || diaphragm_invasion == '是' || ipsilateral_different_lobe_nodule == '是')",
          "describe": "T推断：T4（>7cm 或侵犯纵隔/心脏/大血管/隆突/喉返神经/主气管/食管/椎体/膈肌，或同侧不同肺叶孤立结节）。"
        },
        {
          "id": 9011,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T3" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "tumor_max_diameter_cm", "chest_wall_invasion", "phrenic_nerve_invasion", "pericardium_invasion", "same_lobe_satellite_nodule"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence == '有' && ((tumor_max_diameter_cm > 5 && tumor_max_diameter_cm <= 7) || chest_wall_invasion == '是' || phrenic_nerve_invasion == '是' || pericardium_invasion == '是' || same_lobe_satellite_nodule == '是')",
          "describe": "T推断：T3（5–7cm 或侵犯胸壁/膈神经/心包，或同一肺叶孤立结节）。"
        },
      
        {
          "id": 9012,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T2b" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "tumor_max_diameter_cm", "main_bronchus_invasion", "carina_invasion", "superficial_spreading_limited_to_bronchial_wall", "visceral_pleura_invasion", "obstructive_pneumonitis_or_atelectasis"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence == '有' && ( (tumor_max_diameter_cm > 4 && tumor_max_diameter_cm <= 5) || ( (tumor_max_diameter_cm > 4 && tumor_max_diameter_cm <= 5) && ( (main_bronchus_invasion == '是' && carina_invasion != '是' && superficial_spreading_limited_to_bronchial_wall != '是') || visceral_pleura_invasion == '是' || obstructive_pneumonitis_or_atelectasis == '是' ) ) )",
          "describe": "T推断：T2b（4–5cm；或满足T2触发项且大小落在4–5cm）。"
        },
        {
          "id": 9013,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T2a" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "tumor_max_diameter_cm", "main_bronchus_invasion", "carina_invasion", "superficial_spreading_limited_to_bronchial_wall", "visceral_pleura_invasion", "obstructive_pneumonitis_or_atelectasis"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence == '有' && ( (tumor_max_diameter_cm > 3 && tumor_max_diameter_cm <= 4) || ( tumor_max_diameter_cm <= 4 && ( (main_bronchus_invasion == '是' && carina_invasion != '是' && superficial_spreading_limited_to_bronchial_wall != '是') || visceral_pleura_invasion == '是' || obstructive_pneumonitis_or_atelectasis == '是' ) ) )",
          "describe": "T推断：T2a（3–4cm；或<=4cm但满足T2触发项：侵犯主支气管(未侵隆突且非表浅扩散型)/侵及脏层胸膜/阻塞性肺炎或肺不张）。"
        },
      
        {
          "id": 9014,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T1c" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "tumor_max_diameter_cm"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence == '有' && tumor_max_diameter_cm > 2 && tumor_max_diameter_cm <= 3",
          "describe": "T推断：T1c（2–3cm）。"
        },
        {
          "id": 9015,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T1b" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "tumor_max_diameter_cm"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence == '有' && tumor_max_diameter_cm > 1 && tumor_max_diameter_cm <= 2",
          "describe": "T推断：T1b（1–2cm）。"
        },
        {
          "id": 9016,
          "kind": "staging_rule",
          "target": { "key": "t_category", "value": "T1a" },
          "required_keys": ["infer_tnm", "primary_tumor_evidence", "tumor_max_diameter_cm"],
          "expr": "infer_tnm == '是' && primary_tumor_evidence == '有' && tumor_max_diameter_cm <= 1",
          "describe": "T推断：T1a（≤1cm）。"
        },
        {
          "id": 9101,
          "kind": "staging_rule",
          "target": { "key": "n_category", "value": "NX" },
          "required_keys": ["infer_tnm", "regional_nodes_evaluable"],
          "expr": "infer_tnm == '是' && regional_nodes_evaluable in ['否','不明']",
          "describe": "N推断：NX（区域淋巴结无法评估）。"
        },
        {
          "id": 9102,
          "kind": "staging_rule",
          "target": { "key": "n_category", "value": "N3" },
